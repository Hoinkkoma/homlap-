%%{init: {"theme": "neo", "layout": "elk", "fontFamily": "arial"}}%%
flowchart LR

    Internet["🌐 Internet"]
    
    subgraph Home["🏠 Home Network"]
        Router["Fritzbox<br/>Gateway"]
    end
    
    subgraph Infrastructure["🖧 Network Infrastructure"]
        S8["8-Port Switch<br/>Primary"]
        S4["4-Port Switch<br/>Secondary"]
        PSU["Surge Protection"]
    end
    
    subgraph Compute["🖥️ Compute Hosts"]
        PVE["Proxmox Server<br/>i7 / 32GB RAM<br/>2×256GB + 500GB SSD"]
        DEB["Debian Server<br/>i3 / 16GB RAM<br/>256GB SSD"]
        DIT["Debian IT<br/>Pentium / 2GB RAM"]
    end
    
    subgraph Storage["💾 Storage & Virtualization"]
        ZFS["ZFS Pool"]
        VMS["Virtual Machines"]
        CONT["Docker Containers"]
    end
    
    subgraph Services["☁️ Services"]
        DNS["AdGuard Home<br/>DNS/Filtering"]
        DASH["Homepage<br/>Dashboard"]
        MON["Prometheus/Grafana<br/>Monitoring"]
        MEDIA["Jellyfin<br/>Media Server"]
        CLOUD["Nextcloud<br/>File Storage"]
        ADMIN["Portainer<br/>Container Admin"]
    end
    
    subgraph Print["🖨️ Print Zone"]
        PRINT["Digitus Printserver"]
        HP["HP OfficeJet 400"]
    end
    
    subgraph VPN["🔒 Remote Access"]
        TS["Tailscale VPN"]
        C1["Think Client 1"]
        C2["Think Client 2"]
        C3["Think Client 3"]
    end

    Internet --> Router
    Router --> S8
    S8 --> S4
    S8 --> PSU
    
    S8 --> PVE
    S8 --> DEB
    S8 --> DIT
    S8 --> PRINT
    
    PVE --> ZFS
    ZFS --> VMS
    VMS --> CONT
    
    PVE --> DNS
    PVE --> DASH
    PVE --> MON
    PVE --> MEDIA
    PVE --> CLOUD
    PVE --> ADMIN
    
    DEB --> DNS
    DEB --> DASH
    DEB --> MON
    
    PRINT --> HP
    
    S8 <--> TS
    TS -.-> C1
    TS -.-> C2
    TS -.-> C3
    
    Services -.-> Internet

    classDef internet fill:#0d47a1,stroke:#1976d2,color:#e3f2fd
    classDef home fill:#e65100,stroke:#ff6f00,color:#fff3e0
    classDef network fill:#263238,stroke:#455a64,color:#eceff1
    classDef compute fill:#004d40,stroke:#00897b,color:#e0f2f1
    classDef storage fill:#1a237e,stroke:#3f51b5,color:#e8eaf6
    classDef services fill:#4a148c,stroke:#6a1b9a,color:#f3e5f5
    classDef print fill:#3f2c2c,stroke:#795548,color:#efebe9
    classDef vpn fill:#004d2d,stroke:#00897b,color:#e0f2f1

    class Internet internet
    class Router home
    class S8,S4,PSU network
    class PVE,DEB,DIT compute
    class ZFS,VMS,CONT storage
    class DNS,DASH,MON,MEDIA,CLOUD,ADMIN services
    class PRINT,HP print
    class TS,C1,C2,C3 vpn
